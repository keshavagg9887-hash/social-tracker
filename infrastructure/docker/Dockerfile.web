# ==============================================================================
# Containerized Production Build for Web Frontend [M3/M4]
# Multi-stage build with Node.js & Nginx Alpine
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY apps/web/package*.json ./apps/web/
COPY packages/ ./packages/

# Install root & workspace dependencies
RUN npm install
COPY . .

# Build React / Vite application
RUN npm --workspace=apps/web run build

# Production static serving with Nginx
FROM nginx:alpine

# Copy built distribution files
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# SPA fallback configuration for client-side routing
RUN printf 'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# ==============================================================================
# SOCIAL EMPOWERMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' before running docker compose or local services
# ==============================================================================

# Database Configuration [M3]
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_empowerment_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_empowerment_db

# Redis Broker & Streams [M3]
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_AI_EVENTS=ai:events
REDIS_STREAM_NOTIFICATIONS=sep:notifications
REDIS_CONSUMER_GROUP=sep_incident_engine_group

# FastAPI Backend Service [M3]
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-super-secret-key-in-production-sep-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MediaMTX & Video Gateway [M1]
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
VIDEO_GATEWAY_URL=http://localhost:8888

# AI Detection Worker [M2]
AI_WORKER_CONCURRENCY=2
DETECTION_CONFIDENCE_THRESHOLD=0.5
DEVICE=cpu
MODEL_WEIGHTS_DIR=models/weights

# Notification Worker & Alert Dispatcher [M3]
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@socialtracker.org
SMTP_PASSWORD=change-me
ALERT_RECIPIENT_EMAIL=responders@socialtracker.org
WEBHOOK_URL=

# Web Application Frontend [M4]
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
VITE_STREAM_BASE_URL=http://localhost:8888
VITE_WS_BASE_URL=ws://localhost:8000/ws

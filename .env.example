# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database [M3]
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=social_empowerment_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_empowerment_db

# Redis [M3]
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend API [M3]
API_PORT=8000
API_HOST=0.0.0.0
SECRET_KEY=change-this-to-a-super-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Video Gateway & MediaMTX [M1]
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_API_PORT=9997
VIDEO_GATEWAY_URL=http://localhost:8888

# AI Worker [M2]
AI_WORKER_CONCURRENCY=2
DETECTION_CONFIDENCE_THRESHOLD=0.5
DEVICE=cuda:0

# Notification Worker [M3]
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=secret
SMS_GATEWAY_API_KEY=

# Web Frontend [M4]
VITE_API_BASE_URL=http://localhost:8000
VITE_STREAM_BASE_URL=http://localhost:8888
VITE_WS_BASE_URL=ws://localhost:8000/ws
